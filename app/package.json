{
  "name": "zumilabs-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.js",
    "test:browser:coverage": "vitest run --config vitest.browser.config.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:screens": "playwright test tests/e2e/screens/",
    "test:all": "npm test && npm run test:browser && npm run test:e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0-next.2",
    "@imgly/background-removal": "^1.3.0",
    "@mediabunny/mp3-encoder": "^1.40.1",
    "@mediapipe/tasks-vision": "^0.10.0",
    "@xenova/transformers": "^2.17.2",
    "exifreader": "^4.32.0",
    "gif.js": "^0.2.0",
    "heic2any": "^0.0.4",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.2",
    "mediabunny": "^1.40.1",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^0.5.2",
    "onnxruntime-web": "^1.19.0",
    "piexifjs": "^1.0.6",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.3",
    "smartcrop": "^2.0.5",
    "tesseract.js": "^5.1.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.60.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
